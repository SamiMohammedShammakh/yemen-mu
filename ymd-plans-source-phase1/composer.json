{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ymd/annual-plans",
    "type": "project",
    "description": "نظام الخطط السنوية والمتابعة - جمعية المهندسين اليمنيين في تركيا",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpword": "^1.3",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "packagist.org": false
        },
        {
            "type": "path",
            "url": "../deps/src/*/*",
            "options": {
                "symlink": false,
                "versions": {
                    "laravel/framework": "13.33.0",
                    "mpdf/mpdf": "8.3.1",
                    "phpoffice/phpword": "1.4.0",
                    "phpoffice/phpspreadsheet": "5.10.0",
                    "phpunit/phpunit": "12.5.36",
                    "brick/math": "1.0.0",
                    "doctrine/inflector": "2.1.0",
                    "dragonmantank/cron-expression": "3.6.0",
                    "egulias/email-validator": "4.0.4",
                    "fruitcake/php-cors": "1.4.0",
                    "guzzlehttp/guzzle": "8.2.0",
                    "guzzlehttp/promises": "3.0.2",
                    "guzzlehttp/psr7": "3.1.0",
                    "guzzlehttp/uri-template": "2.0.1",
                    "laravel/prompts": "0.3.24",
                    "laravel/serializable-closure": "2.1.0",
                    "league/commonmark": "2.10.3",
                    "league/flysystem": "3.36.0",
                    "league/flysystem-local": "3.35.3",
                    "league/uri": "7.8.1",
                    "monolog/monolog": "3.12.0",
                    "nesbot/carbon": "3.14.0",
                    "nunomaduro/termwind": "2.4.0",
                    "psr/container": "2.0.2",
                    "psr/http-message": "2.0",
                    "psr/log": "3.0.2",
                    "psr/simple-cache": "3.0.0",
                    "ramsey/uuid": "4.9.4",
                    "symfony/console": "8.1.7",
                    "symfony/error-handler": "8.1.5",
                    "symfony/finder": "8.1.7",
                    "symfony/http-foundation": "8.1.7",
                    "symfony/http-kernel": "8.1.7",
                    "symfony/mailer": "8.1.7",
                    "symfony/mime": "8.1.7",
                    "symfony/polyfill-php84": "1.38.1",
                    "symfony/polyfill-php85": "1.41.0",
                    "symfony/polyfill-php86": "1.41.0",
                    "symfony/process": "8.1.7",
                    "symfony/routing": "8.1.6",
                    "symfony/uid": "8.1.5",
                    "symfony/var-dumper": "8.1.7",
                    "tijsverkoyen/css-to-inline-styles": "2.4.0",
                    "vlucas/phpdotenv": "5.7.0",
                    "voku/portable-ascii": "2.1.1",
                    "mpdf/psr-http-message-shim": "2.0.1",
                    "mpdf/psr-log-aware-trait": "3.0.0",
                    "myclabs/deep-copy": "1.14.0",
                    "paragonie/random_compat": "9.99.100",
                    "setasign/fpdi": "2.6.8",
                    "phpoffice/math": "0.3.0",
                    "composer/pcre": "3.4.0",
                    "maennchen/zipstream-php": "3.2.2",
                    "markbaker/complex": "3.0.2",
                    "markbaker/matrix": "3.0.1",
                    "phar-io/manifest": "2.0.4",
                    "phar-io/version": "3.2.1",
                    "phpunit/php-code-coverage": "12.5.7",
                    "phpunit/php-file-iterator": "6.0.2",
                    "phpunit/php-invoker": "6.0.0",
                    "phpunit/php-text-template": "5.0.0",
                    "phpunit/php-timer": "8.0.0",
                    "sebastian/cli-parser": "4.2.1",
                    "sebastian/comparator": "7.1.8",
                    "sebastian/diff": "7.0.1",
                    "sebastian/environment": "8.1.2",
                    "sebastian/exporter": "7.0.3",
                    "sebastian/global-state": "8.0.3",
                    "sebastian/object-enumerator": "7.0.0",
                    "sebastian/recursion-context": "7.0.1",
                    "sebastian/type": "6.0.4",
                    "sebastian/version": "6.0.0",
                    "staabm/side-effects-detector": "1.0.5",
                    "doctrine/lexer": "3.0.2",
                    "symfony/polyfill-intl-idn": "1.42.0",
                    "psr/http-client": "1.0.3",
                    "psr/http-factory": "1.1.0",
                    "symfony/polyfill-php80": "1.37.0",
                    "symfony/polyfill-php82": "1.38.1",
                    "league/config": "1.2.0",
                    "psr/event-dispatcher": "1.0.0",
                    "symfony/deprecation-contracts": "3.7.1",
                    "league/mime-type-detection": "1.17.0",
                    "league/uri-interfaces": "7.8.1",
                    "carbonphp/carbon-doctrine-types": "3.2.1",
                    "psr/clock": "1.0.0",
                    "symfony/clock": "8.1.0",
                    "symfony/polyfill-mbstring": "1.38.2",
                    "symfony/translation": "8.1.5",
                    "ramsey/collection": "2.1.1",
                    "symfony/service-contracts": "3.7.3",
                    "symfony/string": "8.1.7",
                    "symfony/event-dispatcher": "8.1.5",
                    "symfony/polyfill-ctype": "1.37.0",
                    "symfony/polyfill-uuid": "1.37.0",
                    "symfony/css-selector": "8.1.6",
                    "graham-campbell/result-type": "1.2.0",
                    "phpoption/phpoption": "1.10.0",
                    "nikic/php-parser": "5.9.0",
                    "sebastian/complexity": "5.0.0",
                    "sebastian/lines-of-code": "4.0.1",
                    "theseer/tokenizer": "2.0.1",
                    "sebastian/object-reflector": "5.0.0",
                    "symfony/polyfill-intl-normalizer": "1.42.0",
                    "dflydev/dot-access-data": "3.0.3",
                    "nette/schema": "1.3.6",
                    "symfony/translation-contracts": "3.7.1",
                    "symfony/polyfill-intl-grapheme": "1.41.0",
                    "symfony/event-dispatcher-contracts": "3.7.1",
                    "nette/utils": "4.1.5"
                }
            }
        }
    ]
}
